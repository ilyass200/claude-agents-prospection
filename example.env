# Apollo (sourcing international)
APOLLO_API_KEY=your_apollo_api_key_here

# Pappers (sourcing France — gratuit, données officielles RCS)
# Obtenir sur : https://www.pappers.fr/api → Créer un compte → Générer une clé
PAPPERS_API_KEY=your_pappers_api_key_here

# Brevo (SMTP API) — clé unique partagée par tous les senders
# Obtenir sur : https://app.brevo.com → Profil → SMTP & API → API Keys
# Les adresses expéditrices sont toutes vérifiées sur le même compte Brevo
BREVO_API_KEY=your_brevo_api_key_here

# Google Sheets
GSHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GSHEETS_SHEET_NAME=leads_tracker
GSHEETS_SERVICE_ACCOUNT_KEY=credentials/gsheets_key.json

# Paramètres campagne globaux
ICP_SCORE_MINIMUM=50
SEND_TIME=09:00:00+02:00
EMAIL_DELAY_MINUTES=3
PAYS_CIBLE=France
CA_MINIMUM=500000
SERVICE_PRICE=3000

# Délais relances (en jours)
RELANCE_1_DELAI_JOURS=4
RELANCE_2_DELAI_JOURS=7 # a partir de la relance 1

# -------------------------------------------------------
# SENDERS — Mots de passe IMAP uniquement (un par sender)
# Les senders sont configurés dans senders.json
# Le numéro {N} correspond à l'index du sender dans le JSON (1-indexé)
# -------------------------------------------------------

# Sender 1
IMAP_PASSWORD_1=your_imap_password_here

# Sender 2 (décommenter et remplir pour activer)
# IMAP_PASSWORD_2=your_imap_password_here

# Sender 3 (décommenter et remplir pour activer)
# IMAP_PASSWORD_3=your_imap_password_here
