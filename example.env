# Apollo
APOLLO_API_KEY=your_apollo_api_key_here

# Brevo (SMTP API)
BREVO_API_KEY=your_brevo_api_key_here

# Expéditeur
SENDER_NAME=Votre Nom ou Studio
SENDER_EMAIL=contact@votredomaine.com
SENDER_TITLE=Votre Titre
SENDER_WEBSITE=https://votresite.com

# Google Sheets
GSHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GSHEETS_SHEET_NAME=leads_tracker
GSHEETS_SERVICE_ACCOUNT_KEY=credentials/gsheets_key.json

# IMAP (réception emails)
IMAP_HOST=imap.votrehébergeur.com
IMAP_PORT=993
IMAP_EMAIL=contact@votredomaine.com
IMAP_PASSWORD=your_imap_password_here

# Paramètres campagne
ICP_SCORE_MINIMUM=50
MAX_EMAILS_PAR_JOUR=50
SEND_TIME=09:00:00+02:00
EMAIL_DELAY_MINUTES=3
PAYS_CIBLE=France
CA_MINIMUM=500000
SERVICE_PRICE=3000

# Délais relances (en jours)
RELANCE_1_DELAI_JOURS=4
RELANCE_2_DELAI_JOURS=7 # a partir de la relance 1
